# Desarrollo y producción gratuita con Supabase PostgreSQL
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
JWT_SECRET="cambia-esto-por-un-secreto-de-al-menos-32-caracteres"
ADMIN_PASSWORD="cambia-esta-clave-inicial"
# Opcional: si queda vacía no se crean cuentas demo. Mínimo 8 caracteres.
DEMO_PASSWORD=""
PORT=3001
CORS_ORIGIN="http://localhost:5173"
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="solo-backend-nunca-frontend"
SUPABASE_KYC_BUCKET="kyc-documents"
# Opcional: carpeta de documentos cuando no se usa Supabase (por defecto backend/uploads).
UPLOAD_DIR=""
# Opcional: URL pública de la API que muestra Swagger (por defecto la misma del sitio).
PUBLIC_API_URL=""

# Producción en Render Free (se configura en el panel, nunca en Git):
# NODE_ENV=production
